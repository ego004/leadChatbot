# Database Configuration
DATABASE_URL=mysql+mysqlconnector://username:password@localhost/leadchatbot

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# Google Gemini AI
GOOGLE_API_KEY=your-google-ai-api-key

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development

# Toggle in-memory rate limiting for /api/chat endpoints (true/false)
CHAT_RATE_LIMIT_ENABLED=true
# Require per-client deployment token for /api/chat/{custom_client_id}/message (true/false)
CHAT_REQUIRE_DEPLOYMENT_TOKEN=false

# Embeddings configuration
# Set to a model ID or a local directory path; if local, ensure the model is downloaded
# Example (remote): EMBEDDINGS_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Example (local):  EMBEDDINGS_MODEL_NAME=C:\\models\\all-MiniLM-L6-v2
EMBEDDINGS_MODEL_NAME=

# Offline mode for Hugging Face (set to 1 to enforce offline)
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
