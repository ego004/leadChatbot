# Database Configuration
DATABASE_URL=mysql+mysqlconnector://username:password@localhost/leadchatbot

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# Google Gemini AI
GOOGLE_API_KEY=your-google-ai-api-key

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=LeadGenius AI

# IMAP Configuration for Email Monitoring
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
AUTO_EMAIL_RESPONSE=true
EMAIL_RESPONSE_DELAY=30

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development

# Chat Endpoint Security
# Toggle in-memory rate limiting for /api/chat endpoints (true/false)
CHAT_RATE_LIMIT_ENABLED=true
# Require per-client deployment token for /api/chat/{custom_client_id}/message (true/false)
CHAT_REQUIRE_DEPLOYMENT_TOKEN=false
