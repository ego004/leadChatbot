# Database Configuration
DATABASE_URL=mysql+mysqlconnector://username:password@localhost/leadchatbot

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# Google Gemini AI
GOOGLE_API_KEY=your-google-ai-api-key

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development

# Toggle in-memory rate limiting for /api/chat endpoints (true/false)
CHAT_RATE_LIMIT_ENABLED=true
# Require per-client deployment token for /api/chat/{custom_client_id}/message (true/false)
CHAT_REQUIRE_DEPLOYMENT_TOKEN=false
